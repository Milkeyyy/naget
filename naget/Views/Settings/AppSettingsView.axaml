<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:epoxy="https://github.com/kekyo/Epoxy"
			 xmlns:ctrl="using:naget.Controls"
			 xmlns:cv="clr-namespace:naget.Converter;assembly=naget"
			 xmlns:vm="using:naget.ViewModels.Settings"
			 xmlns:lang="clr-namespace:naget.Assets.Locales;assembly=naget"
			 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 x:Class="naget.Views.Settings.AppSettingsView"
			 x:DataType="vm:AppSettingsViewModel"
			 epoxy:Fountain.Well="{Binding ViewWell}"
>

	<Design.DataContext>
		<vm:AppSettingsViewModel/>
	</Design.DataContext>

	<UserControl.Resources>
		<!--テーマ名コンバーター-->
		<cv:ThemeNameConverter x:Key="themeNameConverter"/>
	</UserControl.Resources>

	<Panel Margin="20">
		<StackPanel>
			<TextBlock Text="{x:Static lang:Resources.Settings_Tab_AppSettings}" Margin="0 0 0 20" FontSize="20" FontWeight="Bold"/>

			<!--設定の適用にはアプリの再起動が必要ですよ表示-->
			<Border Background="#FFF3CD" CornerRadius="4" Padding="12" Margin="0 0 0 10"
					IsVisible="{Binding LanguageNoteTextIsVisible}">
				<Grid ColumnDefinitions="Auto,*,Auto">
					<TextBlock Grid.Column="0" Text="&#x26A0;" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
					<TextBlock Grid.Column="1" Text="{x:Static lang:Resources.Settings_System_Language_RequiredRestart}"
							   VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#856404"/>
					<!--アプリケーション再起動ボタン-->
					<Button Grid.Column="2" Classes="accent" HorizontalAlignment="Right" Margin="8 0 0 0" Command="{Binding RestartAppCommand}">
						<Button.Content>
							<StackPanel Orientation="Horizontal">
								<TextBlock Text="{x:Static lang:Resources.Settings_System_Language_RestartApplication}" Margin="0 0 0 0"/>
							</StackPanel>
						</Button.Content>
					</Button>
				</Grid>
			</Border>

			<!--テーマ-->
			<ctrl:SettingsCard IsExpanded="True" Header="{x:Static lang:Resources.Settings_Design_Theme}" Icon="&#x1F3A8;">
				<ctrl:SettingsCard.Footer>
					<StackPanel Orientation="Horizontal">
						<!--テーマ選択リスト-->
						<ComboBox MinWidth="200" ItemsSource="{Binding ThemeList}" SelectedItem="{Binding SelectedTheme}">
							<ComboBox.ItemTemplate>
								<DataTemplate>
									<!--コンバーターでテーマ名をローカライズしたものを選択肢のテキストとして表示する-->
									<TextBlock Text="{Binding, Converter={StaticResource themeNameConverter}}"/>
								</DataTemplate>
							</ComboBox.ItemTemplate>
						</ComboBox>
					</StackPanel>
				</ctrl:SettingsCard.Footer>
			</ctrl:SettingsCard>

			<!--言語-->
			<ctrl:SettingsCard IsExpanded="True" Icon="&#x1F310;">
				<!--ヘッダー&注意書きテキスト-->
				<ctrl:SettingsCard.Header>
					<StackPanel>
						<!--ヘッダーテキスト-->
						<TextBlock Text="{x:Static lang:Resources.Settings_System_Language}" VerticalAlignment="Center"/>
					</StackPanel>
				</ctrl:SettingsCard.Header>

				<ctrl:SettingsCard.Footer>
					<StackPanel Orientation="Horizontal">
						<!--言語選択リスト-->
						<ComboBox MinWidth="200" ItemsSource="{Binding LanguageList}" SelectedItem="{Binding SelectedLanguage}">
							<ComboBox.ItemTemplate>
								<DataTemplate>
									<TextBlock Text="{Binding DisplayName}"/>
								</DataTemplate>
							</ComboBox.ItemTemplate>
						</ComboBox>
					</StackPanel>
				</ctrl:SettingsCard.Footer>
			</ctrl:SettingsCard>

			<!--アップデート-->
			<ctrl:SettingsCard IsExpanded="True" Icon="&#x1F504;">
				<!--ヘッダー&注意書きテキスト-->
				<ctrl:SettingsCard.Header>
					<StackPanel>
						<!--ヘッダーテキスト-->
						<TextBlock Text="{x:Static lang:Resources.Settings_Update_Check}" VerticalAlignment="Center"/>
					</StackPanel>
				</ctrl:SettingsCard.Header>

				<ctrl:SettingsCard.Footer>
					<StackPanel Orientation="Horizontal">
						<!--アップデートチェックボタン-->
						<Button Margin="10 0 0 0" Command="{Binding CheckUpdateCommand}">
							<Button.Content>
								<StackPanel Orientation="Horizontal">
									<TextBlock Text="{x:Static lang:Resources.Settings_Update_CheckUpdate}" Margin="0 0 0 0"/>
								</StackPanel>
							</Button.Content>
						</Button>
					</StackPanel>
				</ctrl:SettingsCard.Footer>
			</ctrl:SettingsCard>

			<!--このアプリについて-->
			<ctrl:SettingsCard IsExpanded="True" IsClickEnabled="True" Command="{Binding AboutClickCommand}" Icon="&#x2753;" ActionIcon="&#x1F4C2;">
				<!--ヘッダー&注意書きテキスト-->
				<ctrl:SettingsCard.Header>
					<StackPanel>
						<!--ヘッダーテキスト-->
						<TextBlock Text="{x:Static lang:Resources.Settings_About}" VerticalAlignment="Center"/>
					</StackPanel>
				</ctrl:SettingsCard.Header>
			</ctrl:SettingsCard>
		</StackPanel>
	</Panel>
</UserControl>
