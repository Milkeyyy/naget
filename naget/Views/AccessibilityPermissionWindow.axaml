<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:ui="using:FluentAvalonia.UI.Controls"
		xmlns:vm="using:naget.ViewModels"
		xmlns:lang="clr-namespace:naget.Assets.Locales;assembly=naget"
		mc:Ignorable="d" d:DesignWidth="460" d:DesignHeight="400"
		x:Class="naget.Views.AccessibilityPermissionWindow"
		x:DataType="vm:AccessibilityPermissionWindowViewModel"
		WindowStartupLocation="CenterScreen"
		ShowActivated="True"
		CanResize="False"
		SizeToContent="Height"
		Width="460"
		Icon="/Assets/Icon.ico"
		Title="{Binding WindowTitle}"
>

	<Design.DataContext>
		<vm:AccessibilityPermissionWindowViewModel />
	</Design.DataContext>

	<StackPanel Margin="28 24" Spacing="16">
		<!--ヘッダー-->
		<StackPanel Orientation="Horizontal" Spacing="12">
			<Image Source="/Assets/Logo/naget_Symbol_1-1.png" Width="40" Height="40" VerticalAlignment="Center"/>
			<StackPanel VerticalAlignment="Center" Spacing="2">
				<TextBlock Text="{x:Static lang:Resources.Accessibility_Dialog_Title}" FontSize="18" FontWeight="SemiBold"/>
				<TextBlock Text="{x:Static lang:Resources.Accessibility_Dialog_Description}" TextWrapping="Wrap" Opacity="0.7"/>
			</StackPanel>
		</StackPanel>

		<!--権限の状態-->
		<ui:InfoBar Severity="Warning" IsOpen="{Binding !IsPermissionGranted}" IsClosable="False"
					Title="{Binding StatusText}" Message="{x:Static lang:Resources.Accessibility_Status_NotGranted_Description}"/>
		<ui:InfoBar Severity="Success" IsOpen="{Binding IsPermissionGranted}" IsClosable="False"
					Title="{Binding StatusText}" Message="{x:Static lang:Resources.Accessibility_Status_Granted_Description}"/>

		<!--手順-->
		<StackPanel Spacing="8" IsVisible="{Binding !IsPermissionGranted}">
			<Grid ColumnDefinitions="20,*">
				<TextBlock Text="1." FontWeight="SemiBold" Opacity="0.7"/>
				<TextBlock Grid.Column="1" Text="{x:Static lang:Resources.Accessibility_Step_Grant}" TextWrapping="Wrap"/>
			</Grid>
			<Grid ColumnDefinitions="20,*">
				<TextBlock Text="2." FontWeight="SemiBold" Opacity="0.7"/>
				<TextBlock Grid.Column="1" Text="{x:Static lang:Resources.Accessibility_Step_Settings}" TextWrapping="Wrap"/>
			</Grid>
			<Grid ColumnDefinitions="20,*">
				<TextBlock Text="3." FontWeight="SemiBold" Opacity="0.7"/>
				<TextBlock Grid.Column="1" Text="{x:Static lang:Resources.Accessibility_Step_Toggle}" TextWrapping="Wrap"/>
			</Grid>
		</StackPanel>

		<!--操作-->
		<Grid ColumnDefinitions="*,Auto">
			<Button HorizontalAlignment="Left" Content="{x:Static lang:Resources.Accessibility_Button_Later}" Command="{Binding LaterCommand}"/>
			<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
				<Button Content="{x:Static lang:Resources.Accessibility_Button_OpenSystemSettings}" Command="{Binding OpenSystemSettingsCommand}" IsVisible="{Binding !IsPermissionGranted}"/>
				<Button Classes="accent" Content="{x:Static lang:Resources.Accessibility_Button_Grant}" Command="{Binding RequestPermissionCommand}" IsVisible="{Binding !IsPermissionGranted}"/>
				<Button Classes="accent" Content="{x:Static lang:Resources.Settings_System_Language_RestartApplication}" Command="{Binding RestartCommand}" IsVisible="{Binding IsPermissionGranted}"/>
			</StackPanel>
		</Grid>
	</StackPanel>
</Window>
