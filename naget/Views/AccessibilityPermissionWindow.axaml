<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:vm="using:naget.ViewModels"
		xmlns:lang="clr-namespace:naget.Assets.Locales;assembly=naget"
		mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="400"
		x:Class="naget.Views.AccessibilityPermissionWindow"
		x:DataType="vm:AccessibilityPermissionWindowViewModel"
		WindowStartupLocation="CenterScreen"
		ShowActivated="True"
		CanResize="False"
		SizeToContent="WidthAndHeight"
		Icon="/Assets/Icon.ico"
		Title="{Binding WindowTitle}"
>

	<Design.DataContext>
		<vm:AccessibilityPermissionWindowViewModel />
	</Design.DataContext>

	<StackPanel Margin="20 30 20 30" Spacing="10" MaxWidth="480" VerticalAlignment="Center">
		<StackPanel Orientation="Vertical" HorizontalAlignment="Center" Spacing="10">
			<!--ロゴ-->
			<Image Source="/Assets/Logo/naget_Symbol_1-1.png" Width="48" VerticalAlignment="Center" HorizontalAlignment="Center"/>
			<!--タイトル-->
			<TextBlock Text="{x:Static lang:Resources.Accessibility_Dialog_Title}" FontSize="18" FontWeight="Bold" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center"/>
		</StackPanel>
		<!--説明-->
		<TextBlock Text="{x:Static lang:Resources.Accessibility_Dialog_Description}" TextWrapping="Wrap" TextAlignment="Center"/>
		<!--手順-->
		<TextBlock Text="{x:Static lang:Resources.Accessibility_Dialog_HowTo}" TextWrapping="Wrap" TextAlignment="Center" IsVisible="{Binding !IsPermissionGranted}"/>
		<!--権限の状態-->
		<TextBlock Text="{Binding StatusText}" TextAlignment="Center" FontWeight="SemiBold"/>
		<!--権限の要求-->
		<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10" IsVisible="{Binding !IsPermissionGranted}">
			<Button Classes="accent" Content="{x:Static lang:Resources.Accessibility_Button_Grant}" Command="{Binding RequestPermissionCommand}"/>
			<Button Content="{x:Static lang:Resources.Accessibility_Button_OpenSystemSettings}" Command="{Binding OpenSystemSettingsCommand}"/>
		</StackPanel>
		<!--再確認・再起動・後で-->
		<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10" Margin="0 10 0 0">
			<Button Content="{x:Static lang:Resources.Accessibility_Button_Recheck}" Command="{Binding RecheckCommand}"/>
			<Button Content="{x:Static lang:Resources.Settings_System_Language_RestartApplication}" Command="{Binding RestartCommand}"/>
			<Button Content="{x:Static lang:Resources.Accessibility_Button_Later}" Command="{Binding LaterCommand}"/>
		</StackPanel>
	</StackPanel>
</Window>
